# Local Node server configuration. Copy this file to .env and enter your real key.
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-2.5-flash

# auto uses YOLO when the local service is ready and otherwise falls back to Gemini.
# Set to yolo after you have trained a model and want detections only from YOLO.
DETECTOR_MODE=auto
YOLO_URL=http://127.0.0.1:8001
YOLO_CONFIDENCE=0.25
YOLO_IOU=0.45
PORT=3000
